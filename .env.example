# ─── Configurações Compartilhadas do Docker Compose & Backend ─────────────────
APP_NAME="Conta na Massa"
APP_ENV=local
APP_KEY=base64:suachave
APP_DEBUG=true
APP_URL=http://localhost:8000

# ─── Banco de Dados (PostgreSQL) ──────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=conta_na_massa
DB_USERNAME=postgres
DB_PASSWORD="suasenha"

# Variáveis do container PostgreSQL oficial
POSTGRES_DB=conta_na_massa
POSTGRES_USER=postgres
POSTGRES_PASSWORD="suasenha"

# ─── Sessão & Sanctum ────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# ─── Modo Vibe: Provedor de IA (Master Config) ────────────────────────────────
AI_PROVIDER=openai

# OpenAI / Proxy
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
