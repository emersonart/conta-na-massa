APP_NAME="Conta na Massa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_BUILD_ASSETS=false  # false para dev local, true para Docker/produção (executa npm run build no entrypoint)
APP_URL=http://localhost:8000
FRONTEND_URL="${APP_URL}"
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# ─── Banco de Dados (PostgreSQL para Produção / SQLite para Testes) ───────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=conta_na_massa
DB_USERNAME=postgres
DB_PASSWORD=

# ─── Sessão & Sanctum ────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,127.0.0.1:3000,127.0.0.1:8000
VITE_API_BASE_URL=/api/v1

# ─── Cache & Fila ────────────────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database

# ─── Email (configure um transporte SMTP/Resend em produção para entregar links) ─
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@contanamassa.local"
MAIL_FROM_NAME="${APP_NAME}"
REQUIRE_EMAIL_VERIFICATION=false

# ─── GlitchTip (compatível com Sentry) ───────────────────────────────────────
# Única variável obrigatória: DSN do projeto GlitchTip. Vazio = integração
# desativada sem tráfego remoto; logs locais continuam em storage/logs/laravel.log.
# O mesmo DSN ativa erros, logs estruturados (info+), breadcrumbs e tracing no
# Laravel e no navegador. O DSN é público; nunca use aqui tokens/chaves privadas.
SENTRY_LARAVEL_DSN=
# Amostragem de performance (0.01 = 1% das requisições/transações).
SENTRY_TRACES_SAMPLE_RATE=0.01
# Opcional: SENTRY_RELEASE identifica a versão; por padrão usa APP_ENV como ambiente.
SENTRY_RELEASE=

# ─── Modo Vibe: Provedor de IA (Master Config) ────────────────────────────────
# Provedor ativo: openai | anthropic | gemini | openrouter
# Mesmo com outras chaves preenchidas, apenas o valor abaixo determina o ativo.
AI_PROVIDER=openai

# OpenAI (Padrão — suporta baseUrl customizada para proxies/compatíveis)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (Acesso a múltiplos modelos com URL OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Limites e Segurança do Chat
AI_MAX_TOKENS_INPUT=500
AI_MAX_MESSAGES_PER_MINUTE=10
AI_CONVERSATION_TTL_DAYS=30
